# The API key comes from Vercel, not from this file:
#
#   npm run env:link   # once
#   npm run env:pull   # writes .env.development.local
#
# Copy this file to .env.local only to override something on this machine.
#
# ---------------------------------------------------------------
# Option A: Anthropic
# ---------------------------------------------------------------
LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY comes from Vercel

# Stage 1 runs the extract call once per section of every document, so it wants
# a small, fast model. The merge is where quality actually shows.
EXTRACT_MODEL=claude-haiku-4-5-20251001
PROPOSE_MODEL=claude-sonnet-5
# Both default to PROPOSE_MODEL when unset.
# MERGE_MODEL=claude-sonnet-5
# CLUSTER_MODEL=claude-sonnet-5

# ---------------------------------------------------------------
# Option B: OpenAI
# ---------------------------------------------------------------
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# EXTRACT_MODEL=gpt-5-mini
# PROPOSE_MODEL=gpt-5

# ---------------------------------------------------------------
# Tuning
# ---------------------------------------------------------------
# Max AI proposals accepted per pass. Overflow becomes questions.
PROPOSAL_CAP=8

# Where a preload run is kept between requests. Delete the folder to clear them.
PRELOAD_RUN_DIR=.runs
